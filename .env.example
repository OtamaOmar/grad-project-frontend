# Base URL of the Node API (see docs/api-contract.md)
VITE_API_URL=http://localhost:3000/api

# true = answer every API call from src/mocks (no backend needed)
# false = call the real backend at VITE_API_URL
VITE_USE_MOCKS=true

# with mocks on, these path prefixes still call the real backend (comma separated),
# so pages can move over one at a time. Example: /auth,/me,/admin/users
VITE_REAL_API_PATHS=
